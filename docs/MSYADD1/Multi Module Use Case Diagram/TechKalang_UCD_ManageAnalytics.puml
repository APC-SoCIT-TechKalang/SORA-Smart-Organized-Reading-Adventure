@startuml
left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 10
skinparam actorStyle awesome

' Define Actors
actor "Admin" as admin
actor "Reader" as reader
actor "AI" as ai

' Define Module & Use Cases
rectangle "Manage Analytics" {
    usecase "View dashboard overview" as UC_Overview
    usecase "Generate usage report" as UC_GenReport
    usecase "Ask analytics chatbot" as UC_AskChatbot
    usecase "Get book recommendation" as UC_GetRec
}

' Admin Connections
admin --> UC_Overview
admin --> UC_GenReport
admin --> UC_AskChatbot

' Reader Connections
reader --> UC_GetRec

' AI Connections
UC_AskChatbot <-- ai
UC_GetRec <-- ai

@enduml
