@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

Person(reader, "Library Reader", "Browses catalog, reads manga, checks session status, and completes quests")
Person(admin, "Library Admin", "Manages readers, inventory, reading sessions, top-ups, and views operational analytics")

System(sora, "S.O.R.A System", "The Gamified Manga Library System that automates session time tracking, book inventory, gamified rewards, and AI features")
System_Ext(external_ai, "External AI System", "Third-party API used to power quest generation, book recommendations, and analytics queries")

Rel(reader, sora, "Uses kiosk to search the catalog of books, view quests, and interact with AI chatbot")
Rel(admin, sora, "Monitors sessions, scans RFID and barcodes, tops up time, and manages catalog")
Rel(sora, external_ai, "Sends prompts and retrieves generated recommendations & quests")

@enduml