@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

' People / Actors
Person(reader, "Library Reader", "Browses catalog, reads manga, checks session status")
Person(admin, "Library Admin", "Manages readers, inventory, reading sessions, top-ups, and views operational analytics")

' S.O.R.A System Boundary
System_Boundary(c1, "S.O.R.A System Boundary") {
    
    ' Frontends / Apps
    Container(kiosk, "User Kiosk", "Web App", "Allows readers to browse the 4,000+ title catalog, view shelf locations before retrieving books, track session timers, and interact with the AI recommendation chatbot")
    Container(dashboard, "Admin Dashboard", "Web App", "Enables staff to process session top-ups, scan patron RFID cards, manage real-time inventory states, track active readers, and view usage analytics reports")

    ' Core Backend Containers (Matching Level 3 Modules)
    Container(session_ctrl, "Manage Sessions", "Container / Component", "Handles reading session timers, access control, and check-in/check-out")
    Container(book_mgr, "Manage Books", "Container / Component", "Handles book catalog metadata, shelf locations, and physical inventory tracking")
    Container(manage_profile, "Manage Profile", "Container / Component", "Manages reader user profiles, RFID card associations, and credentials")
    Container(gamification, "Manage Quests", "Container / Component", "Controls gamified quests, achievements, and points/reward balances")
    Container(analytics, "Manage Analytics", "Container / Component", "Handles dashboard overview, usage report generation, and analytics queries")

    ' Internal Database
    ContainerDb(db, "Database", "Relational / Document DB", "Stores user profiles, RFID card IDs, book catalog metadata (ISBNs), active reading sessions, quest logs, and points/rewards balance")
}

' External Systems & Devices
System_Ext(rfid_hw, "RFID Reader & Barcode Scanner", "Scans readers RFID library cards for check-in/out and ISBN barcodes on physical manga volumes")
System_Ext(external_ai, "External AI System", "Third-party API used to power quest generation, book recommendations, and analytics queries")

' User Interactivity
Rel(reader, kiosk, "Interacts with")
Rel(admin, dashboard, "Manages system via")

' Kiosk to Services
Rel(kiosk, session_ctrl, "Checks session timer & status")
Rel(kiosk, book_mgr, "Searches catalog & shelf locations")
Rel(kiosk, manage_profile, "Views reading stats & edits account")
Rel(kiosk, gamification, "Views and completes quests")
Rel(kiosk, analytics, "Chats for book recommendations")

' Admin Dashboard to Services
Rel(dashboard, session_ctrl, "Processes top-ups & session states")
Rel(dashboard, book_mgr, "Updates catalog & book inventory")
Rel(dashboard, manage_profile, "Manages reader accounts & encodes RFID")
Rel(dashboard, gamification, "Configures rewards & refines quests")
Rel(dashboard, analytics, "Views usage reports, dashboard overview & analytics chatbot")

' Services to Database
Rel(session_ctrl, db, "Reads/Writes session logs")
Rel(book_mgr, db, "Reads/Writes book catalog data")
Rel(manage_profile, db, "Reads/Writes reader profiles")
Rel(gamification, db, "Reads/Writes points and quest data")
Rel(analytics, db, "Queries aggregate data")

' Hardware & External API Connections
Rel(session_ctrl, rfid_hw, "Receives card scan events")
Rel(book_mgr, rfid_hw, "Receives ISBN barcode inputs")
Rel(manage_profile, rfid_hw, "Links newly encoded RFID cards")
Rel(gamification, external_ai, "Fetches generated AI quests")
Rel(analytics, external_ai, "Sends data for insights, chatbot & recommendations")

@enduml
