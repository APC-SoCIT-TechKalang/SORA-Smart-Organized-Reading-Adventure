NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# The current dashboard targets sora_v2 by default. Set to "public" only when
# using a legacy database that still has the old public schema and RPCs.
NEXT_PUBLIC_SORA_SCHEMA=sora_v2

# Server-only. Required later for staff-created Supabase Auth accounts.
SUPABASE_SECRET_KEY=

# Optional: improves Google Books quota for ISBN lookups.
GOOGLE_BOOKS_API_KEY=

# Optional: enables free-tier AI cleanup/classification for ISBN results.
# Create a key in Google AI Studio and keep it server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
