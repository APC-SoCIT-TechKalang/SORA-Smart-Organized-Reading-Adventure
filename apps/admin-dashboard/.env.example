NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# The current dashboard targets sora_v2 by default. Set to "public" only when
# using a legacy database that still has the old public schema and RPCs.
NEXT_PUBLIC_SORA_SCHEMA=sora_v2

# Server-only. Required later for staff-created Supabase Auth accounts.
SUPABASE_SECRET_KEY=
# Server-only. Same random value as the kiosk Vite server's reader bridge key.
KIOSK_RFID_BRIDGE_KEY=

# Optional: improves Google Books quota for ISBN lookups.
GOOGLE_BOOKS_API_KEY=

# Server-only: OpenRouter enriches missing ISBN classification fields after
# authoritative catalog sources have been checked.
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_SITE_URL=https://sora-admin-puce.vercel.app
OPENROUTER_APP_NAME=Tankobonbon Admin BON

# Optional fallback when OpenRouter is unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
