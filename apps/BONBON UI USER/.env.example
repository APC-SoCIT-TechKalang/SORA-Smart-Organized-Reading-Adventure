VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Leave unset while the current public schema is active. Set to sora_v2 only
# after the replacement schema, access rules, and accounts are provisioned.
VITE_SORA_SCHEMA=
# Local kiosk server only; use the same random value in the admin .env.local.
# Never prefix this key with VITE_. The dev proxy is restricted to loopback.
KIOSK_RFID_BRIDGE_KEY=
# Server-side only: required by the deployed /api/kiosk/rfid-login function.
# Configure it in the reader deployment; never prefix it with VITE_.
SUPABASE_SECRET_KEY=
# Server-side only: used by /api/bon-chat. Never prefix the API key with VITE_.
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_SITE_URL=https://sora-reader.vercel.app
OPENROUTER_APP_NAME=S.O.R.A. BON
